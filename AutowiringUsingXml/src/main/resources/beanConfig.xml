	<bean id="curs2"  class="coms.beans.Course">
		<property name="cname" value="Python"/>
		<property name="duration" value="3 Months"/>
		<property name="fees" value="22000.00"/>
	</bean>
	 -->
	<bean id="stdObj"  class="coms.beans.Student" autowire="byType">
		<property name="sname" value="Satyam Kumar"/>
		<property name="location"  value="Hyderabad"/>
		
	</bean>
	
</beans>